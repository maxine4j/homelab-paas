load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")

pkg_tar(
    name = "binary_layer",
    srcs = ["//services/control-plane"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

pkg_tar(
    name = "ui_layer",
    srcs = ["//services/paas-ui:bundle"],
    mode = "0644",
    package_dir = "/usr/share/homelab-paas/ui",
    strip_prefix = "/services/paas-ui/dist",
)

py_test(
    name = "bundle_test",
    size = "small",
    srcs = ["bundle_test.py"],
    args = ["$(location :ui_layer)"],
    data = [":ui_layer"],
)

# A static musl executable needs no base image or runtime package manager.
# This is the inner control-plane workload; the outer K3s appliance is future work.
oci_image(
    name = "image",
    architecture = select({
        "@platforms//cpu:aarch64": "arm64",
        "@platforms//cpu:x86_64": "amd64",
    }),
    entrypoint = ["/usr/local/bin/control-plane"],
    env = {
        "PAAS_LISTEN": "0.0.0.0:8080",
        "RUST_LOG": "info",
    },
    os = "linux",
    target_compatible_with = [
        "@platforms//os:linux",
        "@zig_sdk//libc:musl",
    ],
    tars = [
        ":binary_layer",
        ":ui_layer",
    ],
    user = "65532:65532",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["homelab-paas/control-plane:dev"],
)
