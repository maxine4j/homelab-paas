[Unit]
Description=Homelab PaaS Envoy ingress
Requires=homelab-paas.service
After=homelab-paas.service

[Container]
Image=docker.io/envoyproxy/envoy:v1.37.0
ContainerName=envoy
Exec=-c /etc/homelab-paas/envoy.yaml
Environment=ENVOY_UID=0
Label=homelab-paas.cluster=prod
Label=homelab-paas.role=envoy
PublishPort=80:80
PublishPort=443:443
Volume=/etc/homelab-paas:/etc/homelab-paas:ro,z
Volume=/var/homelab-paas:/var/homelab-paas:ro,z

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
