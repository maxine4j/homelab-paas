[Unit]
Description=Homelab PaaS control plane
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/maxine4j/homelab-paas:replace-with-release-tag-or-commit-sha
ContainerName=paas
RunInit=true
Label=homelab-paas.cluster=prod
Label=homelab-paas.role=control-plane
Volume=/etc/homelab-paas:/etc/homelab-paas:ro
Volume=/var/homelab-paas:/var/homelab-paas
Volume=/run/podman/podman.sock:/var/run/docker.sock
SecurityLabelDisable=true
HealthCmd=node -e "fetch('http://127.0.0.1:8080/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
HealthInterval=5s
HealthTimeout=3s
HealthRetries=10
Notify=healthy

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
