{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"endOfLine": "lf",
	"experimentalOperatorPosition": "start",
	"insertFinalNewline": true,
	"jsxSingleQuote": true,
	"objectWrap": "preserve",
	"printWidth": 120,
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": false,
	"sortImports": true,
	"sortPackageJson": true,
	"tabWidth": 4,
	"useTabs": true,
	"trailingComma": "all"
}
