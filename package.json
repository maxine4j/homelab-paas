{
	"name": "homelab-paas",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm --filter @homelab-paas/shared-contracts build && pnpm -r typecheck",
		"test": "pnpm --filter @homelab-paas/shared-contracts build && pnpm -r test",
		"test:integration": "pnpm --filter @homelab-paas/shared-contracts build && pnpm --filter @homelab-paas/paas test:integration",
		"test:e2e": "pnpm --filter @homelab-paas/paas test:e2e",
		"test:containers": "node services/paas/tests/containers.mjs",
		"lint": "oxlint --deny-warnings .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck",
		"dev": "pnpm --filter @homelab-paas/shared-contracts build && pnpm --parallel --filter @homelab-paas/paas --filter @homelab-paas/ui dev",
		"image": "docker build -f services/paas/Dockerfile -t homelab-paas/paas:dev .",
		"dev:deploy": "docker compose -f local/docker-compose.yaml up --build -d"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "7.0.2",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@10.34.7"
}
