{
  "name": "homelab-paas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @homelab-paas/shared-contracts build && pnpm -r typecheck",
    "test": "pnpm test:tooling && pnpm --filter @homelab-paas/shared-contracts build && pnpm -r test",
    "test:tooling": "vitest run scripts/lint-rules.test.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "dev": "pnpm --filter @homelab-paas/shared-contracts build && pnpm --parallel --filter @homelab-paas/control-plane --filter @homelab-paas/ui dev",
    "image": "python3 scripts/build-image.py",
    "dev:deploy": "python3 scripts/dev-deploy.py"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.7"
}
