{
	"uid": "paas-control-plane",
	"title": "PaaS control plane",
	"description": "Control-plane HTTP traffic, actual reconciliation attempts and management health/sync snapshots. Request metrics describe the control plane, not workload request handling. Health uses active revision; sync uses desired revision.",
	"tags": ["homelab-paas"],
	"schemaVersion": 40,
	"version": 1,
	"editable": false,
	"timezone": "browser",
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "cluster",
				"label": "cluster",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "victoriametrics"
				},
				"query": {
					"query": "label_values(paas_service_health, cluster)",
					"refId": "StandardVariableQuery"
				},
				"refresh": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			},
			{
				"name": "serviceId",
				"label": "serviceId",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "victoriametrics"
				},
				"query": {
					"query": "label_values(paas_service_health{cluster=~\"$cluster\"}, serviceId)",
					"refId": "StandardVariableQuery"
				},
				"refresh": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			},
			{
				"name": "revision",
				"label": "revision",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "victoriametrics"
				},
				"query": {
					"query": "label_values(paas_service_health{cluster=~\"$cluster\",serviceId=~\"$serviceId\"}, revision)",
					"refId": "StandardVariableQuery"
				},
				"refresh": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"title": "Control-plane requests / second",
			"type": "timeseries",
			"description": "Includes health and authorization calls; independent of service/revision filters.",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (status) (rate(paas_http_requests_total{cluster=~\"$cluster\"}[$__rate_interval]))",
					"legendFormat": "HTTP {{status}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 2,
			"title": "Control-plane server errors / second",
			"type": "timeseries",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 12,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum(rate(paas_http_requests_total{cluster=~\"$cluster\",status=~\"5..\"}[$__rate_interval]))",
					"legendFormat": "{{serviceId}} / {{container_name}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 3,
			"title": "Mean control-plane request duration",
			"type": "timeseries",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 0,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum(rate(paas_http_request_duration_seconds_sum{cluster=~\"$cluster\"}[$__rate_interval])) / sum(rate(paas_http_request_duration_seconds_count{cluster=~\"$cluster\"}[$__rate_interval]))",
					"legendFormat": "{{serviceId}} / {{container_name}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 4,
			"title": "Reconciliation attempts / second",
			"type": "timeseries",
			"description": "Backoff skips are excluded.",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 12,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "ops",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (serviceId, outcome) (rate(paas_reconciliations_total{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"}[$__rate_interval]))",
					"legendFormat": "{{serviceId}} / {{outcome}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 5,
			"title": "Mean reconciliation duration",
			"type": "timeseries",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 0,
				"y": 16,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (serviceId) (rate(paas_reconciliation_duration_seconds_sum{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"}[$__rate_interval])) / sum by (serviceId) (rate(paas_reconciliation_duration_seconds_count{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"}[$__rate_interval]))",
					"legendFormat": "{{serviceId}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 6,
			"title": "Services by health",
			"type": "timeseries",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 12,
				"y": 16,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (health) (paas_service_health{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"})",
					"legendFormat": "{{health}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 7,
			"title": "Services by sync",
			"type": "timeseries",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 0,
				"y": 24,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["lastNotNull"]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (sync) (paas_service_sync{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"})",
					"legendFormat": "{{sync}}",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"id": 8,
			"title": "Current service health",
			"type": "table",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 12,
				"y": 24,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"showHeader": true
			},
			"targets": [
				{
					"refId": "A",
					"expr": "paas_service_health{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"}",
					"format": "table",
					"instant": true
				}
			],
			"transformations": [
				{
					"id": "organize",
					"options": {
						"excludeByName": {
							"Time": true,
							"Value": true,
							"__name__": true,
							"job": true,
							"instance": true
						},
						"indexByName": {
							"cluster": 0,
							"serviceId": 1,
							"revision": 2,
							"health": 3
						}
					}
				}
			]
		},
		{
			"id": 9,
			"title": "Current service sync",
			"type": "table",
			"description": "",
			"datasource": {
				"type": "prometheus",
				"uid": "victoriametrics"
			},
			"gridPos": {
				"x": 0,
				"y": 32,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0
				},
				"overrides": []
			},
			"options": {
				"showHeader": true
			},
			"targets": [
				{
					"refId": "A",
					"expr": "paas_service_sync{cluster=~\"$cluster\",serviceId=~\"$serviceId\",revision=~\"$revision\"}",
					"format": "table",
					"instant": true
				}
			],
			"transformations": [
				{
					"id": "organize",
					"options": {
						"excludeByName": {
							"Time": true,
							"Value": true,
							"__name__": true,
							"job": true,
							"instance": true
						},
						"indexByName": {
							"cluster": 0,
							"serviceId": 1,
							"revision": 2,
							"sync": 3
						}
					}
				}
			]
		}
	]
}
