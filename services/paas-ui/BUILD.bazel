load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//services/paas-ui:oxfmt/package_json.bzl", oxfmt = "bin")
load("@npm//services/paas-ui:oxlint/package_json.bzl", oxlint = "bin")
load("@npm//services/paas-ui:typescript/package_json.bzl", typescript = "bin")
load("@npm//services/paas-ui:vite/package_json.bzl", vite = "bin")
load("@npm//services/paas-ui:vitest/package_json.bzl", vitest = "bin")

npm_link_all_packages(name = "node_modules")

js_binary(
    name = "contract_generator",
    data = [":node_modules/json-schema-to-typescript"],
    entry_point = "tools/contracts/generate.mjs",
)

js_run_binary(
    name = "contracts",
    srcs = ["//packages/shared-contracts:schema"],
    args = ["$(rootpath //packages/shared-contracts:schema)"],
    stdout = "generated/contracts.d.ts",
    tool = ":contract_generator",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "contract_checker",
    data = [
        "tools/contracts/generate.mjs",
        ":node_modules/ajv",
        ":node_modules/json-schema-to-typescript",
    ],
    entry_point = "tools/contracts/check.mjs",
)

js_run_binary(
    name = "contract_check",
    srcs = [
        ":contracts",
        "//packages/shared-contracts:fixtures",
        "//packages/shared-contracts:schema",
    ],
    args = [
        "$(rootpath //packages/shared-contracts:schema)",
        "$(rootpath //packages/shared-contracts:fixtures)",
        "$(rootpath :contracts)",
    ],
    stdout = "contract-check.txt",
    tool = ":contract_checker",
    visibility = ["//visibility:public"],
)

js_test(
    name = "contract_tests",
    args = [
        "$(rootpath //packages/shared-contracts:schema)",
        "$(rootpath //packages/shared-contracts:fixtures)",
        "$(rootpath :contracts)",
    ],
    data = [
        "tools/contracts/generate.mjs",
        ":contracts",
        ":node_modules/ajv",
        ":node_modules/json-schema-to-typescript",
        "//packages/shared-contracts:fixtures",
        "//packages/shared-contracts:schema",
    ],
    entry_point = "tools/contracts/check.mjs",
)

typescript.tsc(
    name = "contract_typecheck",
    srcs = [
        ":contracts",
        ":node_modules",
        ":sources",
    ],
    args = [
        "--noEmit",
        "--project",
        "tools/contracts/tsconfig.json",
    ],
    chdir = package_name(),
    stdout = "contract-typecheck.txt",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "tools/contracts/**",
        "*.ts",
        "*.json",
        "index.html",
        ".ox*.json",
    ]),
)

vite.vite(
    name = "bundle",
    srcs = [
        ":contracts",
        ":node_modules",
        ":sources",
    ],
    args = [
        "build",
        "--outDir",
        "dist",
    ],
    chdir = package_name(),
    out_dirs = ["dist"],
    visibility = ["//visibility:public"],
)

typescript.tsc(
    name = "typecheck",
    srcs = [
        ":contracts",
        ":node_modules",
        ":sources",
    ],
    args = [
        "--noEmit",
        "--project",
        "tsconfig.json",
    ],
    chdir = package_name(),
    stdout = "typecheck.txt",
    visibility = ["//visibility:public"],
)

oxlint.oxlint(
    name = "lint",
    srcs = [
        ":node_modules",
        ":sources",
    ],
    args = [
        "src",
        "tools/contracts",
    ],
    chdir = package_name(),
    stdout = "lint.txt",
    visibility = ["//visibility:public"],
)

oxfmt.oxfmt(
    name = "format_check",
    srcs = [
        ":node_modules",
        ":sources",
    ],
    args = [
        "--check",
        "src",
        "tools/contracts",
        "vite.config.ts",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json",
        "index.html",
    ],
    chdir = package_name(),
    stdout = "format.txt",
    visibility = ["//visibility:public"],
)

vitest.vitest_test(
    name = "tests",
    args = ["run"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
)

vite.vite_binary(
    name = "dev",
    args = [
        "--host",
        "127.0.0.1",
    ],
    chdir = package_name(),
    data = [
        ":contracts",
        ":node_modules",
        ":sources",
    ],
)

exports_files(["pnpm-lock.yaml"])
