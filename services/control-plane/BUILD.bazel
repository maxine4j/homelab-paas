load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy", "rust_library", "rust_test", "rustfmt_test")

rust_library(
    name = "lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "control_plane",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = ["//packages/shared-contracts:lib"] + all_crate_deps(normal = True),
)

rust_binary(
    name = "control-plane",
    srcs = ["src/main.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [":lib"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    crate = ":lib",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_clippy(
    name = "clippy",
    visibility = ["//visibility:public"],
    deps = [
        ":control-plane",
        ":lib",
    ],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":lib",
        ":control-plane",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "format_check",
    testonly = True,
    srcs = [":rustfmt"],
    output_group = "rustfmt_checks",
    visibility = ["//visibility:public"],
)

exports_files(["Cargo.toml"])
